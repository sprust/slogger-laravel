# root user is set by default
# to find user id and group id on linux use commands `id -u` and `id -g`
DOCKER_USER_ID=0
DOCKER_GROUP_ID=0

SLOGGER_TOKEN=
SLOGGER_DISPATCHER_QUEUE_SOCKET_CLIENT_TYPE=direct
SLOGGER_DISPATCHER_QUEUE_SOCKET_CLIENT_URL=tcp://127.0.0.1:9002
# Relative to the project root. Leading/trailing slashes are ignored:
# /storage/slogger/traces/ and storage/slogger/traces are equivalent.
SLOGGER_LOCAL_PROXY_TRACES_PATH=storage/slogger/traces
SLOGGER_LOCAL_PROXY_RETENTION_HOURS=24
SLOGGER_LOCAL_PROXY_MAX_SPOOL_BYTES=1073741824
